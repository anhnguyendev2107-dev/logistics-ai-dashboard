# AI provider keys. The chat uses a fallback pool: Gemini → Anthropic → OpenAI.
# Set AT LEAST ONE. Each var is comma-separated so you can pool multiple keys.
# The dashboard works without any keys; only /chat requires them.

# Google Gemini — any of these names works (deduped if multiple set):
GEMINI_API_KEY=
# GOOGLE_API_KEYS=key1,key2

# Anthropic Claude:
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEYS=key1,key2

# OpenAI:
OPENAI_API_KEY=
# OPENAI_API_KEYS=key1,key2

# Optional: cache size (default 500 entries, 30-min TTL)
CACHE_MAX_ITEMS=500
